# IDE files
.idea/

# OS metadata
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
env/

# Build / packaging
dist/
build/
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Large model / dataset artifacts
data/*
!data/manifests/
*.pth
*.pt
*.onnx

# Legacy auto-generated datasets (regeneratable via legacy/generate_dataset.py).
# Tracked images live under legacy/images/test_images/.
legacy/images/original/
legacy/images/styled/

# Playwright MCP working directory (snapshots, console logs)
.playwright-mcp/

# Built style packs (FiveK-derived, research licence): rebuild with tools/build_stylepacks.py
stylepacks/

# Studio front-end build tooling (the built studio/dist is committed)
node_modules/
!studio/dist/

# GitHub Pages build (npm run build:pages; deployed by .github/workflows/pages.yml)
site/
# Publishable style packs for the hosted Studio only (tools/export_web.py styles --roots stylepacks webpacks)
webpacks/
